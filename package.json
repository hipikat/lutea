{
  "name": "lutea",
  "version": "1.0.0",
  "description": "Node tooling for the Lutea CMS",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipikat/lutea.git"
  },
  "keywords": [],
  "author": "Ada Wright",
  "license": "MIT",
  "homepage": "https://github.com/hipikat/lutea",
  "bugs": {
    "url": "https://github.com/hipikat/lutea/issues"
  },
  "engines": {
    "node": "^26.0.0",
    "pnpm": ">=12.2.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vite": "pnpm run vite:prod && pnpm run vite:debug",
    "vite:debug": "NODE_ENV=development vite build --mode development --minify false --sourcemap --manifest manifest.json --outDir build/vite/debug",
    "vite:prod": "NODE_ENV=production vite build --mode production --sourcemap --manifest manifest.json --outDir build/vite/prod",
    "watch:vite": "pnpm run \"/^watch:vite:(debug|prod)$/\"",
    "watch:vite:debug": "pnpm run vite:debug --watch",
    "watch:vite:prod": "pnpm run vite:prod --watch",
    "build": "pnpm run vite",
    "build:debug": "pnpm run vite:debug",
    "build:prod": "pnpm run vite:prod",
    "watch:build": "pnpm run watch:vite",
    "watch:build:debug": "pnpm run watch:vite:debug",
    "watch:build:prod": "pnpm run watch:vite:prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
